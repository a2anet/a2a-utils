{
    "format_on_save": "on",
    "formatter": "auto",
    "tab_size": 4,
    "preferred_line_length": 100,
    "languages": {
        "Python": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "python/.venv/bin/ruff",
                    "arguments": ["format", "--stdin-filename", "{buffer_path}"]
                }
            }
        },
        "TypeScript": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "javascript/node_modules/.bin/biome",
                    "arguments": ["format", "--stdin-file-path", "{buffer_path}"]
                }
            }
        },
        "JSON": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "javascript/node_modules/.bin/biome",
                    "arguments": ["format", "--stdin-file-path", "{buffer_path}"]
                }
            }
        },
        "JSONC": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "javascript/node_modules/.bin/biome",
                    "arguments": ["format", "--stdin-file-path", "{buffer_path}"]
                }
            }
        }
    }
}
